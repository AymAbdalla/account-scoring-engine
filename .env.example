# Copy this file to .env and fill in the three values.
# .env is ignored by git, so the values never reach GitHub. Never paste them into chat.

# The address of your Salesforce org, starting with https:// (your "My Domain" address).
SF_INSTANCE_URL=

# From the External Client App in Salesforce Setup: the Consumer Key.
SF_CLIENT_ID=

# From the same screen: the Consumer Secret. Treat it like a password.
SF_CLIENT_SECRET=
